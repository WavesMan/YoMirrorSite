# YoMirrorSite 环境变量配置模板
# 复制此文件为 .env 并修改对应值
# 所有配置项也可通过 configs/config.yaml 设置

# === 服务配置 ===
ADDR=:8080
GOROUTINE_POOL_SIZE=100

# === S3 对象存储（必填）===
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=https://s3.example.com
S3_BUCKET_NAME=mirror-bucket
S3_LISTEN_DIR=mirrors/

# === Redis 缓存 ===
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# === 缓存配置 ===
CACHE_FILES_LIST_REFRESH_INTERVAL_SEC=300
CACHE_LOCAL_ENABLED=true
CACHE_LOCAL_SIZE=1000
CACHE_LOCAL_MODE=lru

# === 镜像站同步 ===
MIRROR_SYNC_INTERVAL_MINUTES=30
MIRROR_SYNC_MAX_CONCURRENT=3
MIRROR_SYNC_GITHUB_TOKEN=ghp_xxxxxxxxxxxx
