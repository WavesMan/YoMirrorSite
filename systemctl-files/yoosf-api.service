# 生产部署前需要删除注释
[Unit]
Description=MirrorWeb API Service
After=network.target

[Service]
User=<input_your_user>      # 运行服务的用户
Group=<input_your_user_group>       # 运行服务的用户组
WorkingDirectory=<path_to_your>/mirror_website      # 工作目录，Path到你的项目根目录
ExecStart=<path_to_your>/mirror_website/bin/api     # 启动命令，Path到你的可执行文件
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target