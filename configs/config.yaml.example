# 服务配置
server:
  port: 8080
  goroutine_pool_size: 100
  parallel_download_threads: 5

# Redis配置
redis:
  addr: "localhost:6379"
  password: ""
  db: 0

# 缓存配置
cache:
  filesListRefreshIntervalSec: 300
  # 本地热点缓存配置
  local_cache:
    enabled: true                    # 是否启用本地缓存
    size: 1000                       # 本地缓存容量（条目数）
    mode: "lru"                      # 缓存模式：lru（最近最少使用）或 lfu（最不经常使用）
    hot_data_refresh_sec: 30         # 热点数据刷新间隔（秒）
    hot_data_threshold: 10           # 热点数据访问阈值

# S3对象存储配置
s3:
  access_key: "your-access-key"
  secret_key: "your-secret-key"
  endpoint: "https://s3.example.com"
  bucket_name: "your-bucket-name"
  listen_dir: "public/"
  cors:
    allowed_origins:
      - "https://example.com"
      - "https://www.example.com"
    allowed_methods:
      - "GET"
      - "POST"
      - "PUT"
      - "DELETE"
    allowed_headers:
      - "Authorization"
      - "Content-Type"
    max_age_seconds: 3600

# ============================================================
# 软件镜像站配置
# ============================================================
mirror:
  # ============================================================
  # 多同步规则说明
  # sync_rule 支持三种模式（按软件仓库分别配置）：
  #   incremental     — 增量同步：只拉取新版本（默认，不写即为此模式）
  #   latest_only     — 只保留最新：增量同步后自动清理旧版本
  #   full_historical — 全量历史：拉取所有 Release，适合首次部署
  # ============================================================
  software_list:
    # 规则 1：增量同步（默认，无需显式声明 sync_rule）
    - id: "vscode"
      name: "Visual Studio Code"
      github_repo: "microsoft/vscode"
      category: "editor"
      tags: ["开发工具", "编辑器", "微软"]
      filter_assets:
        - platform: "windows-x64"
          pattern: "VSCode-win32-x64-*.zip"
        - platform: "linux-x64"
          pattern: "code-stable-x64-*.tar.gz"
      sync_prerelease: false
      # sync_rule 未设置，默认 incremental

    # 规则 2：只保留最新 3 个版本（节省磁盘空间）
    - id: "golang"
      name: "Go"
      github_repo: "golang/go"
      category: "language"
      tags: ["编程语言"]
      sync_rule: "latest_only"
      keep_versions: 3
      filter_assets:
        - platform: "linux-amd64"
          pattern: "go*.linux-amd64.tar.gz"

    # 规则 3：首次全量历史同步，之后自动切回增量
    - id: "redis"
      name: "Redis"
      github_repo: "redis/redis"
      category: "database"
      tags: ["数据库", "缓存"]
      sync_rule: "full_historical"
      full_sync_once: true       # 首次全量后自动切回 incremental
      filter_assets:
        - platform: "linux-x64"
          pattern: "redis-*.tar.gz"
  sync:
    interval_minutes: 30
    github_token: "${GITHUB_TOKEN}"
    max_concurrent: 3
    retry_attempts: 3

# ============================================================
# PostgreSQL 持久化配置（可选，不配则降级到纯 S3+Redis）
# ============================================================
postgres:
  host: "localhost"
  port: 5432
  user: "yomirror"
  password: "${PG_PASSWORD}"
  dbname: "yomirror"
  sslmode: "disable"
  max_conns: 10
# ============================================================
# 日志配置
# ============================================================
log:
  level: "debug"                # debug / info / warn / error
  file:
    enabled: true               # 启用文件存储
    path: "logs/app.log"
    max_size_mb: 100            # 单文件上限
    max_backups: 10             # 保留归档数
    max_age_days: 30            # 最大保留天数
    compress: true              # gzip 归档
